<Window x:Class="NexCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexCalc" Width="500" Height="880" Icon="Assets/nexcalc.ico"
        Background="#171724" Foreground="#EEF0F8" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A2A40"/>
            <Setter Property="Foreground" Value="#EEF0F8"/>
            <Setter Property="BorderBrush" Value="#3A3A55"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#8FD8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="fnKey" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="numKey" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#333349"/>
            <Setter Property="Foreground" Value="#F5F6FA"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#C8D2E8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="#222234" BorderBrush="#3A3A55"
                                BorderThickness="1,1,1,0" CornerRadius="6,6,0,0"
                                Margin="2,5,2,0" Padding="16,8">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#3A3A6A"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#8FD8FF"/>
                                <Setter Property="Foreground" Value="#8FD8FF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="tabBorder" Property="Background" Value="#2A2A44"/>
                                <Setter Property="Foreground" Value="#EEF0F8"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#2A2A44" BorderBrush="#333348" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Button x:Name="menuBtn" Content="&#x2630; Menu" Click="Menu_Click" HorizontalAlignment="Left"
                        Padding="12,4" Background="#3A3A6A" Foreground="#EEF0F8" FontWeight="Bold"/>
                <Popup x:Name="modePopup" PlacementTarget="{Binding ElementName=menuBtn}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True">
                    <Border Background="#222234" BorderBrush="#333348" BorderThickness="1" CornerRadius="6" Width="210">
                        <StackPanel>
                            <Button Content="Scientific" Click="Mode_Click" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,8" Background="#222234"
                                    Foreground="#EEF0F8" BorderThickness="0"/>
                            <Button Content="Programmer" Click="Mode_Click" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,8" Background="#222234"
                                    Foreground="#EEF0F8" BorderThickness="0"/>
                            <Button Content="Graph" Click="Mode_Click" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,8" Background="#222234"
                                    Foreground="#EEF0F8" BorderThickness="0"/>
                            <Button Content="Python" Click="Mode_Click" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,8" Background="#222234"
                                    Foreground="#EEF0F8" BorderThickness="0"/>
                            <Button Content="Stat" Click="Mode_Click" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,8" Background="#222234"
                                    Foreground="#EEF0F8" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <TextBlock x:Name="modeTitle" Text="Scientific" FontSize="16" Foreground="#8FD8FF"
                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid x:Name="panelScientific" Margin="16,16,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="560"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#222234" Padding="10" CornerRadius="6" Margin="0,0,0,6"
                        BorderBrush="#333348" BorderThickness="1">
                    <TextBlock x:Name="displayText" Text="0" FontSize="30" TextWrapping="Wrap"
                               TextAlignment="Right" Foreground="#EEF0F8"/>
                </Border>
                <ListBox x:Name="historyBox" Grid.Row="1" Background="#1B1B2B" Foreground="#9FB4C8"
                         BorderBrush="#333348" FontSize="12" Margin="0,0,0,6" HorizontalContentAlignment="Right"
                         MouseDoubleClick="History_DoubleClick"/>
                <Border x:Name="mathPrintBorder" Grid.Row="2" Background="#20202F" Padding="8,4" CornerRadius="6"
                        Margin="0,0,0,6" BorderBrush="#333348" BorderThickness="1" Visibility="Collapsed">
                    <TextBlock x:Name="mathPrint" FontFamily="Consolas" FontSize="16" Foreground="#C9E8FF"
                               TextAlignment="Left" Text=""/>
                </Border>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Angle:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9FB4C8"/>
                    <ComboBox x:Name="angleCombo" Width="90" SelectedIndex="0">
                        <ComboBoxItem>DEG</ComboBoxItem>
                        <ComboBoxItem>RAD</ComboBoxItem>
                        <ComboBoxItem>GRAD</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Display:" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="#9FB4C8"/>
                    <ComboBox x:Name="displayCombo" Width="72" SelectedIndex="0">
                        <ComboBoxItem>Norm</ComboBoxItem>
                        <ComboBoxItem>Fix</ComboBoxItem>
                        <ComboBoxItem>Sci</ComboBoxItem>
                        <ComboBoxItem>DMS</ComboBoxItem>
                        <ComboBoxItem>Frac</ComboBoxItem>
                        <ComboBoxItem>Mixed</ComboBoxItem>
                    </ComboBox>
                    <ComboBox x:Name="displayDigits" Width="48" Margin="6,0,0,0" SelectedIndex="0">
                        <ComboBoxItem>0</ComboBoxItem>
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>9</ComboBoxItem>
                        <ComboBoxItem>10</ComboBoxItem>
                    </ComboBox>
                    <CheckBox x:Name="mathPrintToggle" Content="MathPrint" Margin="14,0,0,0"
                              VerticalAlignment="Center" Foreground="#9FB4C8"
                              Checked="MathPrint_Toggle" Unchecked="MathPrint_Toggle"/>
                </StackPanel>
                <TextBox x:Name="exprBox" Grid.Row="4" FontSize="18" FontFamily="Consolas" Padding="6"
                         Background="#222234" Foreground="#EEF0F8" BorderBrush="#333348"
                         KeyDown="Expr_KeyDown" TextChanged="Expr_TextChanged" Margin="0,0,0,6"/>
                <StackPanel Grid.Row="5">
                    <UniformGrid Rows="8" Columns="6">
                        <Button Content="sin" Click="Key_Click" Style="{StaticResource fnKey}"/>
                        <Button Content="cos" Click="Key_Click" Style="{StaticResource fnKey}"/>
                        <Button Content="tan" Click="Key_Click" Style="{StaticResource fnKey}"/>
                        <Button Content="ln" Click="Key_Click" Style="{StaticResource fnKey}"/>
                        <Button Content="log" Click="Key_Click" Style="{StaticResource fnKey}"/>
                        <Button Content="^" Click="Key_Click" Style="{StaticResource fnKey}"/>
                        <Button Content="sinh" Click="Key_Click" Style="{StaticResource fnKey}"/>
                        <Button Content="cosh" Click="Key_Click" Style="{StaticResource fnKey}"/>
                        <Button Content="tanh" Click="Key_Click" Style="{StaticResource fnKey}"/>
                        <Button Content="sqrt" Click="Key_Click" Style="{StaticResource fnKey}"/>
                        <Button Content="exp" Click="Key_Click" Style="{StaticResource fnKey}"/>
                        <Button Content="dms" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="d/c" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="x²" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="x³" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="1/x" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="logb" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="Rand#" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="pol" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="rec" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="X" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="Y" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="i" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#FFC069"/>
                        <Button Content="conj" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="arg" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="cmplx" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="π" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#FFC069"/>
                        <Button Content="e" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#FFC069"/>
                        <Button Content="A" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="B" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="M+" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#FFC069"/>
                        <Button Content="MR" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#FFC069"/>
                        <Button Content="MC" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#FFC069"/>
                        <Button Content="STO" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="RCL" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="ANS" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="∫" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#FFC069"/>
                        <Button Content="d/dx" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#FFC069"/>
                        <Button Content="nCr" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#FFC069"/>
                        <Button Content="nPr" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#FFC069"/>
                        <Button Content="(" Click="Key_Click" Style="{StaticResource fnKey}"/>
                        <Button Content=")" Click="Key_Click" Style="{StaticResource fnKey}"/>
                        <Button Content="D" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="%" Click="Key_Click" Style="{StaticResource fnKey}"/>
                        <Button Content="poly2" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="poly3" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="poly4" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                        <Button Content="solve" Click="Key_Click" Style="{StaticResource fnKey}" Foreground="#8FD8A0"/>
                    </UniformGrid>
                    <UniformGrid Rows="4" Columns="6">
                        <Button Content="7" Click="Key_Click" Style="{StaticResource numKey}"/>
                        <Button Content="8" Click="Key_Click" Style="{StaticResource numKey}"/>
                        <Button Content="9" Click="Key_Click" Style="{StaticResource numKey}"/>
                        <Button Content="DEL" Click="Key_Click" Style="{StaticResource numKey}" Background="#B5433C" Foreground="#FFFFFF" FontSize="16"/>
                        <Button Content="AC" Click="Key_Click" Style="{StaticResource numKey}" Background="#B5433C" Foreground="#FFFFFF" FontSize="16"/>
                        <Button Style="{StaticResource numKey}" IsEnabled="False" Background="#1E1E2C"/>
                        <Button Content="4" Click="Key_Click" Style="{StaticResource numKey}"/>
                        <Button Content="5" Click="Key_Click" Style="{StaticResource numKey}"/>
                        <Button Content="6" Click="Key_Click" Style="{StaticResource numKey}"/>
                        <Button Content="*" Click="Key_Click" Style="{StaticResource numKey}"/>
                        <Button Content="/" Click="Key_Click" Style="{StaticResource numKey}"/>
                        <Button Style="{StaticResource numKey}" IsEnabled="False" Background="#1E1E2C"/>
                        <Button Content="1" Click="Key_Click" Style="{StaticResource numKey}"/>
                        <Button Content="2" Click="Key_Click" Style="{StaticResource numKey}"/>
                        <Button Content="3" Click="Key_Click" Style="{StaticResource numKey}"/>
                        <Button Content="+" Click="Key_Click" Style="{StaticResource numKey}"/>
                        <Button Content="-" Click="Key_Click" Style="{StaticResource numKey}"/>
                        <Button Style="{StaticResource numKey}" IsEnabled="False" Background="#1E1E2C"/>
                        <Button Content="0" Click="Key_Click" Style="{StaticResource numKey}"/>
                        <Button Content="." Click="Key_Click" Style="{StaticResource numKey}"/>
                        <Button Content="EXP" Click="Key_Click" Style="{StaticResource numKey}" FontSize="16"/>
                        <Button Content="(-)" Click="Key_Click" Style="{StaticResource numKey}" FontSize="16"/>
                        <Button Content="=" Click="Key_Click" Style="{StaticResource numKey}" Background="#3A3A6A" Foreground="#8FD8FF" FontWeight="Bold"/>
                        <Button Content="SPC" Click="Key_Click" Style="{StaticResource numKey}" FontSize="16"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
            </Grid>
            <Grid x:Name="panelStat" Grid.Row="1" Visibility="Collapsed" Margin="16,16,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#222234" Padding="10" CornerRadius="6" Margin="0,0,0,6"
                        BorderBrush="#333348" BorderThickness="1">
                    <TextBlock x:Name="statDisplay" Text="0" FontSize="28" TextWrapping="Wrap"
                               TextAlignment="Right" Foreground="#EEF0F8"/>
                </Border>
                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="C" Click="StatClear_Click" Foreground="#FFC069"
                            Width="54" Margin="4,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="=" Click="StatEval_Click" Background="#3A3A6A"
                              Foreground="#8FD8FF" FontWeight="Bold" Width="54" Margin="4,0,0,0"/>
                    <TextBox x:Name="statExpr" FontSize="18" FontFamily="Consolas" Padding="6"
                             Background="#222234" Foreground="#EEF0F8" BorderBrush="#333348"
                             KeyDown="StatExpr_KeyDown"/>
                </DockPanel>
                <TextBlock x:Name="statMsg" Grid.Row="2" Foreground="#FFB3B3" TextWrapping="Wrap"
                           Margin="0,0,0,6" FontSize="12" Text=""/>
                <UniformGrid Grid.Row="3" Rows="7" Columns="4">
                    <Button Content="DATA+" Click="StatKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="n" Click="StatKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="&#x03A3;x" Click="StatKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="&#x03A3;x&#x00B2;" Click="StatKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="Avg" Click="StatKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="&#x03C3;n" Click="StatKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="&#x03C3;n-1" Click="StatKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="Var" Click="StatKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="Min" Click="StatKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="Max" Click="StatKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="CLR" Click="StatKey_Click" Foreground="#FFC069"/>
                    <Button Content=")" Click="StatKey_Click"/>
                    <Button Content="DAT2" Click="StatKey_Click" Foreground="#FFC069"/>
                    <Button Content="LIN" Click="StatKey_Click" Foreground="#FFC069"/>
                    <Button Content="LOG" Click="StatKey_Click" Foreground="#FFC069"/>
                    <Button Content="EXP" Click="StatKey_Click" Foreground="#FFC069"/>
                    <Button Content="POW" Click="StatKey_Click" Foreground="#FFC069"/>
                    <Button Content="INV" Click="StatKey_Click" Foreground="#FFC069"/>
                    <Button Content="QUAD" Click="StatKey_Click" Foreground="#FFC069"/>
                    <Button Content="r" Click="StatKey_Click" Foreground="#8FD8FF"/>
                    <Button Content="A" Click="StatKey_Click" Foreground="#8FD8FF"/>
                    <Button Content="B" Click="StatKey_Click" Foreground="#8FD8FF"/>
                    <Button Content="C" Click="StatKey_Click" Foreground="#8FD8FF"/>
                    <Button Content="&#x03A3;xy" Click="StatKey_Click" Foreground="#8FD8FF"/>
                    <Button Content="x&#x0304;" Click="StatKey_Click" Foreground="#8FD8FF"/>
                    <Button Content="y&#x0304;" Click="StatKey_Click" Foreground="#8FD8FF"/>
                    <Button Content="&#x0177;" Click="StatKey_Click" Foreground="#8FD8FF"/>
                    <Button Content="x&#x0302;" Click="StatKey_Click" Foreground="#8FD8FF"/>
                </UniformGrid>
            </Grid>
            <Grid x:Name="panelGraph" Visibility="Collapsed" Margin="16,16,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="graphExpr" Grid.Row="0" FontSize="16" FontFamily="Consolas" Padding="6"
                         Background="#222234" Foreground="#EEF0F8" BorderBrush="#333348"
                         Text="sin(x)" KeyDown="GraphExpr_KeyDown" Margin="0,0,0,6"/>
                <TextBox x:Name="graphExpr2" Grid.Row="1" FontSize="16" FontFamily="Consolas" Padding="6"
                         Background="#222234" Foreground="#EEF0F8" BorderBrush="#333348"
                         Text="" KeyDown="GraphExpr_KeyDown" Margin="0,0,0,6"
                         ToolTip="Y2 - optional second curve. Leave empty for one curve."/>
                <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                    <TextBlock Text="min:" Foreground="#9FB4C8" VerticalAlignment="Center"/>
                    <TextBox x:Name="graphMinText" Width="48" Text="-10" Margin="4,0,6,0"
                             Background="#222234" Foreground="#EEF0F8" BorderBrush="#333348"/>
                    <TextBlock Text="max:" Foreground="#9FB4C8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBox x:Name="graphMaxText" Width="48" Text="10" Margin="4,0,6,0"
                             Background="#222234" Foreground="#EEF0F8" BorderBrush="#333348"/>
                    <TextBlock Text="Ymin:" Foreground="#9FB4C8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBox x:Name="graphYminText" Width="48" Text="auto" Margin="4,0,6,0"
                             Background="#222234" Foreground="#EEF0F8" BorderBrush="#333348"/>
                    <TextBlock Text="Ymax:" Foreground="#9FB4C8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBox x:Name="graphYmaxText" Width="48" Text="auto" Margin="4,0,6,0"
                             Background="#222234" Foreground="#EEF0F8" BorderBrush="#333348"/>
                    <TextBlock Text="samples:" Foreground="#9FB4C8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBox x:Name="graphSamplesText" Width="40" Text="100" Margin="4,0,6,0"
                             Background="#222234" Foreground="#EEF0F8" BorderBrush="#333348"/>
                    <TextBlock Text="Xscl:" Foreground="#9FB4C8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBox x:Name="graphXsclText" Width="40" Text="1" Margin="4,0,6,0"
                             Background="#222234" Foreground="#EEF0F8" BorderBrush="#333348"/>
                    <TextBlock Text="Yscl:" Foreground="#9FB4C8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBox x:Name="graphYsclText" Width="40" Text="1" Margin="4,0,6,0"
                             Background="#222234" Foreground="#EEF0F8" BorderBrush="#333348"/>
                    <CheckBox x:Name="polarCheck" Content="polar r(θ)" Margin="10,0,0,0"
                              Foreground="#EEF0F8" VerticalAlignment="Center"/>
                    <CheckBox x:Name="paramCheck" Content="param X(x),Y(x)" Margin="10,0,0,0"
                              Foreground="#EEF0F8" VerticalAlignment="Center"/>
                    <Button Content="Plot" Click="Plot_Click" Padding="10,2" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Zoom In" Click="Zoom_Click" Tag="in" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Zoom Out" Click="Zoom_Click" Tag="out" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Trace" Click="Trace_Click" Tag="next" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="◀" Click="Trace_Click" Tag="prev" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="▶" Click="Trace_Click" Tag="next" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Root" Click="GraphSolve_Click" Tag="root" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Inter" Click="GraphSolve_Click" Tag="inter" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Tangent" Click="Sketch_Click" Tag="tan" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Horiz" Click="Sketch_Click" Tag="h" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Vert" Click="Sketch_Click" Tag="v" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </WrapPanel>
                <Border Grid.Row="3" Background="#12121E" BorderBrush="#333348" BorderThickness="1" Margin="0,0,0,6">
                    <Canvas x:Name="graphCanvas" Background="Transparent" ClipToBounds="True"/>
                </Border>
                <TextBlock x:Name="graphMsg" Grid.Row="4" Foreground="#9FB4C8" FontSize="12"
                           TextWrapping="Wrap" Text="Type f(x) = expression of x, or r(θ) in polar mode."/>
            </Grid>
            </Grid>
            <Grid x:Name="panelPython" Visibility="Collapsed" Margin="16,16,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="280"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="pySource" Grid.Row="0" AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="Consolas" Padding="6" Background="#222234" Foreground="#EEF0F8"
                         BorderBrush="#333348" VerticalScrollBarVisibility="Auto"
                         KeyDown="PySource_KeyDown" Text="print('Hello from NexCalc')" Margin="0,0,0,6"/>
                <Button Grid.Row="1" Content="Run" Click="RunPython_Click" Padding="14,4"
                        Margin="0,0,0,6" HorizontalAlignment="Left" FontWeight="Bold"/>
                <TextBox x:Name="pyOutput" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                         FontFamily="Consolas" FontSize="12" Background="#1B1B2B" Foreground="#A8E6A1"
                         BorderBrush="#333348" VerticalScrollBarVisibility="Auto"/>
            </Grid>
            </Grid>
            <Grid x:Name="panelProg" Visibility="Collapsed" Margin="16,16,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="progExpr" Grid.Row="0" FontSize="18" FontFamily="Consolas" Padding="6"
                         Background="#222234" Foreground="#EEF0F8" BorderBrush="#333348"
                         KeyDown="ProgExpr_KeyDown" Margin="0,0,0,6"/>
                <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                    <TextBlock Text="base:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9FB4C8"/>
                    <ComboBox x:Name="progBase" Width="72" SelectedIndex="1" SelectionChanged="ProgBase_Changed">
                        <ComboBoxItem>DEC</ComboBoxItem>
                        <ComboBoxItem>HEX</ComboBoxItem>
                        <ComboBoxItem>OCT</ComboBoxItem>
                        <ComboBoxItem>BIN</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="width:" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="#9FB4C8"/>
                    <ComboBox x:Name="progWidth" Width="60" SelectedIndex="2" SelectionChanged="ProgWidth_Changed">
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>16</ComboBoxItem>
                        <ComboBoxItem>32</ComboBoxItem>
                        <ComboBoxItem>64</ComboBoxItem>
                    </ComboBox>
                    <Button Content="=" Click="ProgEval_Click" Padding="18,4" Margin="16,0,0,0"
                            Background="#3A3A6A" Foreground="#8FD8FF" FontWeight="Bold"/>
                    <Button Content="C" Click="ProgClear_Click" Padding="16,4" Margin="8,0,0,0" Foreground="#FFC069"/>
                </WrapPanel>
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DEC" Foreground="#9FB4C8" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="HEX" Foreground="#9FB4C8" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="OCT" Foreground="#9FB4C8" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="BIN" Foreground="#9FB4C8" VerticalAlignment="Center"/>
                    <TextBlock x:Name="progDec" Grid.Row="0" Grid.Column="1" Text="0" FontFamily="Consolas" FontSize="15" Foreground="#EEF0F8"/>
                    <TextBlock x:Name="progHex" Grid.Row="1" Grid.Column="1" Text="0" FontFamily="Consolas" FontSize="15" Foreground="#EEF0F8"/>
                    <TextBlock x:Name="progOct" Grid.Row="2" Grid.Column="1" Text="0" FontFamily="Consolas" FontSize="15" Foreground="#EEF0F8"/>
                    <TextBlock x:Name="progBin" Grid.Row="3" Grid.Column="1" Text="0" FontFamily="Consolas" FontSize="15" Foreground="#EEF0F8"/>
                </Grid>
                <TextBlock x:Name="progMsg" Grid.Row="3" TextWrapping="Wrap" Foreground="#FFB3B3" Margin="0,0,0,6"/>
                <UniformGrid Grid.Row="4" Rows="6" Columns="6">
                    <Button Content="A" Click="ProgKey_Click"/>
                    <Button Content="B" Click="ProgKey_Click"/>
                    <Button Content="C" Click="ProgKey_Click"/>
                    <Button Content="D" Click="ProgKey_Click"/>
                    <Button Content="E" Click="ProgKey_Click"/>
                    <Button Content="F" Click="ProgKey_Click"/>
                    <Button Content="and" Click="ProgKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="or" Click="ProgKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="xor" Click="ProgKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="shl" Click="ProgKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="shr" Click="ProgKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="~" Click="ProgKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="mod" Click="ProgKey_Click" Foreground="#8FD8A0"/>
                    <Button Content="+" Click="ProgKey_Click"/>
                    <Button Content="-" Click="ProgKey_Click"/>
                    <Button Content="*" Click="ProgKey_Click"/>
                    <Button Content="/" Click="ProgKey_Click"/>
                    <Button Content="!" Click="ProgKey_Click"/>
                    <Button Content="0" Click="ProgKey_Click"/>
                    <Button Content="1" Click="ProgKey_Click"/>
                    <Button Content="2" Click="ProgKey_Click"/>
                    <Button Content="3" Click="ProgKey_Click"/>
                    <Button Content="4" Click="ProgKey_Click"/>
                    <Button Content="5" Click="ProgKey_Click"/>
                    <Button Content="6" Click="ProgKey_Click"/>
                    <Button Content="7" Click="ProgKey_Click"/>
                    <Button Content="8" Click="ProgKey_Click"/>
                    <Button Content="9" Click="ProgKey_Click"/>
                    <Button Content="0x" Click="ProgKey_Click" Foreground="#FFC069"/>
                    <Button Content="0b" Click="ProgKey_Click" Foreground="#FFC069"/>
                    <Button Content="0o" Click="ProgKey_Click" Foreground="#FFC069"/>
                    <Button Content="(" Click="ProgKey_Click"/>
                    <Button Content=")" Click="ProgKey_Click"/>
                    <Button Content="&#x232B;" Click="ProgKey_Click" Foreground="#FFC069"/>
                    <Button Content="=" Click="ProgEval_Click" Background="#3A3A6A" Foreground="#8FD8FF" FontWeight="Bold"/>
                </UniformGrid>
            </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
