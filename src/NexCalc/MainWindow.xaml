<Window x:Class="NexCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexCalc" Width="500" Height="880" Icon="Assets/nexcalc.ico"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#171724"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EEF0F8"/>
        <SolidColorBrush x:Key="ButtonBrush" Color="#2A2A40"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3A3A55"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8FD8FF"/>
        <SolidColorBrush x:Key="NumberKeyBrush" Color="#333349"/>
        <SolidColorBrush x:Key="NumberTextBrush" Color="#F5F6FA"/>
        <SolidColorBrush x:Key="TabTextBrush" Color="#C8D2E8"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#222234"/>
        <SolidColorBrush x:Key="SelectedBrush" Color="#3A3A6A"/>
        <SolidColorBrush x:Key="ToolbarBrush" Color="#2A2A44"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#333348"/>
        <SolidColorBrush x:Key="OutputBrush" Color="#1B1B2B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9FB4C8"/>
        <SolidColorBrush x:Key="FunctionBrush" Color="#8FD8A0"/>
        <SolidColorBrush x:Key="WarmBrush" Color="#FFC069"/>
        <SolidColorBrush x:Key="EmptyBrush" Color="#1E1E2C"/>
        <SolidColorBrush x:Key="ChartBrush" Color="#12121E"/>
        <SolidColorBrush x:Key="CodeOutputBrush" Color="#A8E6A1"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#FF6E6E"/>
        <SolidColorBrush x:Key="ChartLabelBrush" Color="#9696B8"/>
        <SolidColorBrush x:Key="ChartAxisBrush" Color="#464E64"/>
        <SolidColorBrush x:Key="CurveBrush" Color="#66AAFF"/>
        <SolidColorBrush x:Key="TangentBrush" Color="#C58FFF"/>
        <SolidColorBrush x:Key="SketchBrush" Color="#FF9E9E"/>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="fnKey" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="numKey" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource NumberKeyBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NumberTextBrush}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TabTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ButtonBorderBrush}"
                                BorderThickness="1,1,1,0" CornerRadius="6,6,0,0"
                                Margin="2,5,2,0" Padding="16,8">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource ToolbarBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Button x:Name="menuBtn" Content="&#x2630; Menu" Click="Menu_Click" HorizontalAlignment="Left"
                        Padding="12,4" Background="{DynamicResource SelectedBrush}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold"/>
                <Popup x:Name="modePopup" PlacementTarget="{Binding ElementName=menuBtn}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Width="210">
                        <StackPanel>
                            <Button Content="Standard" Click="Mode_Click" HorizontalContentAlignment="Left"
                                    Padding="12,8" Background="{DynamicResource SurfaceBrush}" BorderThickness="0"/>
                            <Button Content="Scientific" Click="Mode_Click" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,8" Background="{DynamicResource SurfaceBrush}"
                                    Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                            <Button Content="Programmer" Click="Mode_Click" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,8" Background="{DynamicResource SurfaceBrush}"
                                    Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                            <Button Content="Graph" Click="Mode_Click" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,8" Background="{DynamicResource SurfaceBrush}"
                                    Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                            <Button Content="Python" Click="Mode_Click" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,8" Background="{DynamicResource SurfaceBrush}"
                                    Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                            <Button Content="Stat" Click="Mode_Click" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="12,8" Background="{DynamicResource SurfaceBrush}"
                                    Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                            <Button Content="Carpenter" Click="Mode_Click" HorizontalContentAlignment="Left"
                                    Padding="12,8" Background="{DynamicResource SurfaceBrush}" BorderThickness="0"/>
                            <Button Content="Unit Converter" Click="Mode_Click" HorizontalContentAlignment="Left"
                                    Padding="12,8" Background="{DynamicResource SurfaceBrush}" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button x:Name="themeButton" Content="Light theme" Click="Theme_Click" HorizontalAlignment="Right" Padding="12,4"/>
                <TextBlock x:Name="modeTitle" Text="Scientific" FontSize="16" Foreground="{DynamicResource AccentBrush}"
                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <ScrollViewer Visibility="Collapsed" x:Name="standardView" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="panelStandard" Margin="16"/>
            </ScrollViewer>
            <ScrollViewer Visibility="Collapsed" x:Name="carpenterView" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="panelCarpenter" Margin="16"/>
            </ScrollViewer>
            <ScrollViewer Visibility="Collapsed" x:Name="converterView" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="panelConverter" Margin="16"/>
            </ScrollViewer>
            <Grid x:Name="panelScientific" Margin="16,16,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="10" CornerRadius="6" Margin="0,0,0,6"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="displayText" Text="0" FontSize="30" TextWrapping="Wrap"
                                   TextAlignment="Right" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="exactResult" Visibility="Collapsed" TextAlignment="Right"
                                   TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>
                <ListBox x:Name="historyBox" Grid.Row="1" Background="{DynamicResource OutputBrush}" Foreground="{DynamicResource MutedBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" FontSize="12" Margin="0,0,0,6" HorizontalContentAlignment="Right"
                         MouseDoubleClick="History_DoubleClick"/>
                <Border x:Name="mathPrintBorder" Grid.Row="2" Background="#20202F" Padding="8,4" CornerRadius="6"
                        Margin="0,0,0,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Visibility="Collapsed">
                    <TextBlock x:Name="mathPrint" FontFamily="Consolas" FontSize="16" Foreground="#C9E8FF"
                               TextAlignment="Left" Text=""/>
                </Border>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Angle:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}"/>
                    <ComboBox x:Name="angleCombo" Width="90" SelectedIndex="0">
                        <ComboBoxItem>DEG</ComboBoxItem>
                        <ComboBoxItem>RAD</ComboBoxItem>
                        <ComboBoxItem>GRAD</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Display:" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="{DynamicResource MutedBrush}"/>
                    <ComboBox x:Name="displayCombo" SelectionChanged="DisplaySettings_Changed" Width="72" SelectedIndex="0">
                        <ComboBoxItem>Norm</ComboBoxItem>
                        <ComboBoxItem>Fix</ComboBoxItem>
                        <ComboBoxItem>Sci</ComboBoxItem>
                        <ComboBoxItem>DMS</ComboBoxItem>
                        <ComboBoxItem>Frac</ComboBoxItem>
                        <ComboBoxItem>Mixed</ComboBoxItem>
                    </ComboBox>
                    <ComboBox x:Name="displayDigits" SelectionChanged="DisplaySettings_Changed" Width="48" Margin="6,0,0,0" SelectedIndex="0">
                        <ComboBoxItem>0</ComboBoxItem>
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>9</ComboBoxItem>
                        <ComboBoxItem>10</ComboBoxItem>
                    </ComboBox>
                    <CheckBox x:Name="mathPrintToggle" Content="MathPrint" Margin="14,0,0,0"
                              VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                              Checked="MathPrint_Toggle" Unchecked="MathPrint_Toggle"/>
                </StackPanel>
                <TextBox x:Name="exprBox" Grid.Row="4" FontSize="18" FontFamily="Consolas" Padding="6"
                         Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                         KeyDown="Expr_KeyDown" TextChanged="Expr_TextChanged" Margin="0,0,0,6"/>
                <StackPanel Grid.Row="5">
                    <ToggleButton x:Name="shiftButton" Content="Shift" Click="Shift_Click" HorizontalAlignment="Left" Padding="12,4" Margin="2"/>
                    <UniformGrid x:Name="scientificKeys" Columns="6">
                        <Button Content="sin" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="cos" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="tan" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="ln" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="log" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="^" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="exp" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="x²" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="1/x" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="d/c" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="Rand#" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="%" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="pol" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="X" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="i" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="conj" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="π" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="A" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="M+" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="MR" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="STO" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="ANS" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="∫" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="nCr" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="poly2" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="poly4" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="D" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="(" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content=")" Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                        <Button Content="," Click="Key_Click" Style="{StaticResource fnKey}" MinHeight="32"/>
                    </UniformGrid>
                    <UniformGrid Columns="5">
                        <Button Content="7" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="8" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="9" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="DEL" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="AC" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="4" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="5" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="6" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="*" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="/" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="1" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="2" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="3" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="+" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="-" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="0" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="." Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="(-)" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="SPC" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                        <Button Content="=" Click="Key_Click" Style="{StaticResource numKey}" MinHeight="36"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
            </Grid>
            <Grid x:Name="panelStat" Grid.Row="1" Visibility="Collapsed" Margin="16,16,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}" Padding="10" CornerRadius="6" Margin="0,0,0,6"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="statDisplay" Text="0" FontSize="28" TextWrapping="Wrap"
                               TextAlignment="Right" Foreground="{DynamicResource TextBrush}"/>
                </Border>
                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="C" Click="StatClear_Click" Foreground="{DynamicResource WarmBrush}"
                            Width="54" Margin="4,0,0,0"/>
                    <Button DockPanel.Dock="Right" Content="=" Click="StatEval_Click" Background="{DynamicResource SelectedBrush}"
                              Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Width="54" Margin="4,0,0,0"/>
                    <TextBox x:Name="statExpr" FontSize="18" FontFamily="Consolas" Padding="6"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                             KeyDown="StatExpr_KeyDown"/>
                </DockPanel>
                <TextBlock x:Name="statMsg" Grid.Row="2" Foreground="#FFB3B3" TextWrapping="Wrap"
                           Margin="0,0,0,6" FontSize="12" Text=""/>
                <UniformGrid Grid.Row="3" Rows="7" Columns="4">
                    <Button Content="DATA+" Click="StatKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="n" Click="StatKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="&#x03A3;x" Click="StatKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="&#x03A3;x&#x00B2;" Click="StatKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="Avg" Click="StatKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="&#x03C3;n" Click="StatKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="&#x03C3;n-1" Click="StatKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="Var" Click="StatKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="Min" Click="StatKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="Max" Click="StatKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="CLR" Click="StatKey_Click" Foreground="{DynamicResource WarmBrush}"/>
                    <Button Content=")" Click="StatKey_Click"/>
                    <Button Content="DAT2" Click="StatKey_Click" Foreground="{DynamicResource WarmBrush}"/>
                    <Button Content="LIN" Click="StatKey_Click" Foreground="{DynamicResource WarmBrush}"/>
                    <Button Content="LOG" Click="StatKey_Click" Foreground="{DynamicResource WarmBrush}"/>
                    <Button Content="EXP" Click="StatKey_Click" Foreground="{DynamicResource WarmBrush}"/>
                    <Button Content="POW" Click="StatKey_Click" Foreground="{DynamicResource WarmBrush}"/>
                    <Button Content="INV" Click="StatKey_Click" Foreground="{DynamicResource WarmBrush}"/>
                    <Button Content="QUAD" Click="StatKey_Click" Foreground="{DynamicResource WarmBrush}"/>
                    <Button Content="r" Click="StatKey_Click" Foreground="{DynamicResource AccentBrush}"/>
                    <Button Content="A" Click="StatKey_Click" Foreground="{DynamicResource AccentBrush}"/>
                    <Button Content="B" Click="StatKey_Click" Foreground="{DynamicResource AccentBrush}"/>
                    <Button Content="C" Click="StatKey_Click" Foreground="{DynamicResource AccentBrush}"/>
                    <Button Content="&#x03A3;xy" Click="StatKey_Click" Foreground="{DynamicResource AccentBrush}"/>
                    <Button Content="x&#x0304;" Click="StatKey_Click" Foreground="{DynamicResource AccentBrush}"/>
                    <Button Content="y&#x0304;" Click="StatKey_Click" Foreground="{DynamicResource AccentBrush}"/>
                    <Button Content="&#x0177;" Click="StatKey_Click" Foreground="{DynamicResource AccentBrush}"/>
                    <Button Content="x&#x0302;" Click="StatKey_Click" Foreground="{DynamicResource AccentBrush}"/>
                </UniformGrid>
            </Grid>
            <Grid x:Name="panelGraph" Visibility="Collapsed" Margin="16,16,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="graphExpr" Grid.Row="0" FontSize="16" FontFamily="Consolas" Padding="6"
                         Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                         Text="sin(x)" KeyDown="GraphExpr_KeyDown" Margin="0,0,0,6"/>
                <TextBox x:Name="graphExpr2" Grid.Row="1" FontSize="16" FontFamily="Consolas" Padding="6"
                         Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                         Text="" KeyDown="GraphExpr_KeyDown" Margin="0,0,0,6"
                         ToolTip="Y2 - optional second curve. Leave empty for one curve."/>
                <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                    <TextBlock Text="min:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="graphMinText" Width="48" Text="-10" Margin="4,0,6,0"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                    <TextBlock Text="max:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBox x:Name="graphMaxText" Width="48" Text="10" Margin="4,0,6,0"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                    <TextBlock Text="Ymin:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBox x:Name="graphYminText" Width="48" Text="auto" Margin="4,0,6,0"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                    <TextBlock Text="Ymax:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBox x:Name="graphYmaxText" Width="48" Text="auto" Margin="4,0,6,0"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                    <TextBlock Text="samples:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBox x:Name="graphSamplesText" Width="40" Text="100" Margin="4,0,6,0"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                    <TextBlock Text="Xscl:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBox x:Name="graphXsclText" Width="40" Text="1" Margin="4,0,6,0"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                    <TextBlock Text="Yscl:" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBox x:Name="graphYsclText" Width="40" Text="1" Margin="4,0,6,0"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                    <CheckBox x:Name="polarCheck" Content="polar r(θ)" Margin="10,0,0,0"
                              Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    <CheckBox x:Name="paramCheck" Content="param X(x),Y(x)" Margin="10,0,0,0"
                              Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    <Button Content="Number pad" Click="GraphPad_Click" Padding="8,2"/>
                    <Button Content="Plot" Click="Plot_Click" Padding="10,2" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Zoom In" Click="Zoom_Click" Tag="in" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Zoom Out" Click="Zoom_Click" Tag="out" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Trace" Click="Trace_Click" Tag="next" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="◀" Click="Trace_Click" Tag="prev" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="▶" Click="Trace_Click" Tag="next" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Root" Click="GraphSolve_Click" Tag="root" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Inter" Click="GraphSolve_Click" Tag="inter" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Tangent" Click="Sketch_Click" Tag="tan" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Horiz" Click="Sketch_Click" Tag="h" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Vert" Click="Sketch_Click" Tag="v" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </WrapPanel>
                <StackPanel x:Name="graphPad" Grid.Row="3" Visibility="Collapsed" Margin="0,0,0,6"/>
                <Border Grid.Row="4" Background="{DynamicResource ChartBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6">
                    <Canvas x:Name="graphCanvas" Background="Transparent" ClipToBounds="True"/>
                </Border>
                <TextBlock x:Name="graphMsg" Grid.Row="5" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                           TextWrapping="Wrap" Text="Type f(x) = expression of x, or r(θ) in polar mode."/>
            </Grid>
            </Grid>
            <Grid x:Name="panelPython" Visibility="Collapsed" Margin="16,16,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="70"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*" MinHeight="90"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="pySource" Grid.Row="0" AcceptsReturn="True" AcceptsTab="True"
                         FontFamily="Consolas" Padding="6" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" VerticalScrollBarVisibility="Auto"
                         KeyDown="PySource_KeyDown" Text="print('Hello from NexCalc')" Margin="0,0,0,6"/>
                <Grid Grid.Row="1">
                    <GridSplitter HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="5"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource BorderBrush}"/>
                    <DockPanel Margin="0,10,0,6">
                        <Button DockPanel.Dock="Left" Content="Run" Click="RunPython_Click" Padding="14,4" FontWeight="Bold"/>
                        <TextBlock Text="Output" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Grid>
                <TextBox x:Name="pyOutput" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="12" Background="{DynamicResource OutputBrush}" Foreground="{DynamicResource CodeOutputBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" VerticalScrollBarVisibility="Auto"/>
            </Grid>
            </Grid>
            <Grid x:Name="panelProg" Visibility="Collapsed" Margin="16,16,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="progExpr" Grid.Row="0" FontSize="18" FontFamily="Consolas" Padding="6"
                         Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                         KeyDown="ProgExpr_KeyDown" Margin="0,0,0,6"/>
                <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                    <TextBlock Text="base:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}"/>
                    <ComboBox x:Name="progBase" Width="72" SelectedIndex="1" SelectionChanged="ProgBase_Changed">
                        <ComboBoxItem>DEC</ComboBoxItem>
                        <ComboBoxItem>HEX</ComboBoxItem>
                        <ComboBoxItem>OCT</ComboBoxItem>
                        <ComboBoxItem>BIN</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="width:" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="{DynamicResource MutedBrush}"/>
                    <ComboBox x:Name="progWidth" Width="60" SelectedIndex="2" SelectionChanged="ProgWidth_Changed">
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>16</ComboBoxItem>
                        <ComboBoxItem>32</ComboBoxItem>
                        <ComboBoxItem>64</ComboBoxItem>
                    </ComboBox>
                    <Button Content="=" Click="ProgEval_Click" Padding="18,4" Margin="16,0,0,0"
                            Background="{DynamicResource SelectedBrush}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                    <Button Content="C" Click="ProgClear_Click" Padding="16,4" Margin="8,0,0,0" Foreground="{DynamicResource WarmBrush}"/>
                </WrapPanel>
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DEC" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="HEX" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="OCT" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="BIN" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="progDec" Grid.Row="0" Grid.Column="1" Text="0" FontFamily="Consolas" FontSize="15" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="progHex" Grid.Row="1" Grid.Column="1" Text="0" FontFamily="Consolas" FontSize="15" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="progOct" Grid.Row="2" Grid.Column="1" Text="0" FontFamily="Consolas" FontSize="15" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="progBin" Grid.Row="3" Grid.Column="1" Text="0" FontFamily="Consolas" FontSize="15" Foreground="{DynamicResource TextBrush}"/>
                </Grid>
                <TextBlock x:Name="progMsg" Grid.Row="3" TextWrapping="Wrap" Foreground="#FFB3B3" Margin="0,0,0,6"/>
                <UniformGrid Grid.Row="4" Rows="6" Columns="6">
                    <Button Content="A" Click="ProgKey_Click"/>
                    <Button Content="B" Click="ProgKey_Click"/>
                    <Button Content="C" Click="ProgKey_Click"/>
                    <Button Content="D" Click="ProgKey_Click"/>
                    <Button Content="E" Click="ProgKey_Click"/>
                    <Button Content="F" Click="ProgKey_Click"/>
                    <Button Content="and" Click="ProgKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="or" Click="ProgKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="xor" Click="ProgKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="shl" Click="ProgKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="shr" Click="ProgKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="~" Click="ProgKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="mod" Click="ProgKey_Click" Foreground="{DynamicResource FunctionBrush}"/>
                    <Button Content="+" Click="ProgKey_Click"/>
                    <Button Content="-" Click="ProgKey_Click"/>
                    <Button Content="*" Click="ProgKey_Click"/>
                    <Button Content="/" Click="ProgKey_Click"/>
                    <Button Content="!" Click="ProgKey_Click"/>
                    <Button Content="0" Click="ProgKey_Click"/>
                    <Button Content="1" Click="ProgKey_Click"/>
                    <Button Content="2" Click="ProgKey_Click"/>
                    <Button Content="3" Click="ProgKey_Click"/>
                    <Button Content="4" Click="ProgKey_Click"/>
                    <Button Content="5" Click="ProgKey_Click"/>
                    <Button Content="6" Click="ProgKey_Click"/>
                    <Button Content="7" Click="ProgKey_Click"/>
                    <Button Content="8" Click="ProgKey_Click"/>
                    <Button Content="9" Click="ProgKey_Click"/>
                    <Button Content="0x" Click="ProgKey_Click" Foreground="{DynamicResource WarmBrush}"/>
                    <Button Content="0b" Click="ProgKey_Click" Foreground="{DynamicResource WarmBrush}"/>
                    <Button Content="0o" Click="ProgKey_Click" Foreground="{DynamicResource WarmBrush}"/>
                    <Button Content="(" Click="ProgKey_Click"/>
                    <Button Content=")" Click="ProgKey_Click"/>
                    <Button Content="&#x232B;" Click="ProgKey_Click" Foreground="{DynamicResource WarmBrush}"/>
                    <Button Content="=" Click="ProgEval_Click" Background="{DynamicResource SelectedBrush}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                </UniformGrid>
            </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
